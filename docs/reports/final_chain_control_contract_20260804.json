    "adapter_dry_run": "tools/final_chain_control.py adapter-dry-run --chain-id <chain_id> --input <path> --json",
    "job_inspect": "tools/final_chain_control.py job-inspect --record <relative_record_path> --json",
    "job_transition": "tools/final_chain_control.py job-transition --record <relative_record_path> --status <status> --reason <reason> --json"
  },
  "job_lifecycle_policy": {
    "schema_version": "final_chain_job_lifecycle.v0.1",
    "terminal_statuses": [
      "cancelled",
      "dry_run_failed",
      "dry_run_passed",
      "rejected",
      "scheduled_blocked"
    ],
    "allowed_transitions": {
      "cancelled": [],
      "dry_run_failed": [],
      "dry_run_passed": [],
      "dry_run_started": [
        "dry_run_passed",
        "dry_run_failed",
        "cancelled"
      ],
      "rejected": [],
      "scheduled_blocked": [],
      "scheduled_ready": [
        "dry_run_started",
        "cancelled"
      ]
    }
  },
