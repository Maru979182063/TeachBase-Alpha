{
  "schema_version": "teachbase_java_shell_contract.v0.1",
  "workspace_contract": "relative_git_paths_only",
  "absolute_paths_as_inputs": false,
  "consumer_role": "java_orchestrator_or_ui_backend",
  "scope": "external durable shell for four protected final chains",
  "protected_chain_ids": [
    "doc_math",
    "doc_english",
    "pdf_math",
    "pdf_english"
  ],
  "task_state_machine": {
    "statuses": [
      "queued",
      "running",
      "waiting_review",
      "failed_retryable",
      "failed_final",
      "completed"
    ],
    "initial_status": "queued",
    "terminal_statuses": [
      "failed_final",
      "completed"
    ],
    "retryable_status": "failed_retryable",
    "allowed_transitions": {
      "queued": [
        "running",
        "failed_final"
      ],
      "running": [
        "waiting_review",
        "failed_retryable",
        "failed_final",
        "completed"
      ],
      "waiting_review": [
        "running",
        "failed_final",
        "completed"
      ],
      "failed_retryable": [
        "queued",
        "running",
        "failed_final"
      ],
      "failed_final": [],
      "completed": []
    },
    "checkpoint_policy": {
      "checkpoint_per_node_required": true,
      "resume_from_last_successful_node": true,
      "checkpoint_artifact_kind": "node_checkpoint",
      "checkpoint_path_policy": "relative_outputs_path_only"
    },
    "failure_contract": {
      "structured_failure_required": true,
      "required_fields": [
        "code",
        "message",
        "retryable",
        "chain_id",
        "task_id",
        "node_id",
        "attempt",
        "evidence"
      ],
      "retryable_true_maps_to": "failed_retryable",
      "retryable_false_maps_to": "failed_final"
    }
  },
  "database_contract": {
    "engine": "postgres",
    "business_secrets_in_contract": false,
    "tables": [
      {
        "name": "source_files",
        "purpose": "original uploads and immutable source metadata",
        "required_columns": [
          "id",
          "sha256",
          "original_filename",
          "mime_type",
          "storage_uri",
          "created_at",
          "created_by"
        ]
      },
      {
        "name": "tasks",
        "purpose": "one durable processing task visible to UI",
        "required_columns": [
          "id",
          "chain_id",
          "source_file_id",
          "status",
          "dedupe_key",
          "priority",
          "attempt_count",
          "max_attempts",
          "created_at",
          "updated_at",
          "locked_by",
          "lock_expires_at",
          "heartbeat_at",
          "last_error_code"
        ]
      },
      {
        "name": "node_runs",
        "purpose": "per-node attempts, checkpoints, and structured failures",
        "required_columns": [
          "id",
          "task_id",
          "chain_id",
          "node_id",
          "attempt",
          "status",
          "checkpoint_artifact_id",
          "started_at",
          "finished_at",
          "error_code",
          "error_json"
        ]
      },
      {
        "name": "artifacts",
        "purpose": "all durable outputs and checkpoints",
        "required_columns": [
          "id",
          "task_id",
          "node_run_id",
          "artifact_kind",
          "storage_uri",
          "sha256",
          "content_type",
          "created_at"
        ]
      },
      {
        "name": "questions",
        "purpose": "normalized question package rows exposed to review and export",
        "required_columns": [
          "id",
          "task_id",
          "source_file_id",
          "question_type",
          "payload_json",
          "source_trace_json",
          "version_id",
          "created_at"
        ]
      },
      {
        "name": "reviews",
        "purpose": "human review decisions and corrections",
        "required_columns": [
          "id",
          "task_id",
          "question_id",
          "review_status",
          "review_payload_json",
          "reviewed_by",
          "reviewed_at"
        ]
      },
      {
        "name": "version_sources",
        "purpose": "pipeline, model, prompt, config, and artifact provenance",
        "required_columns": [
          "id",
          "chain_id",
          "pipeline_version",
          "config_digest",
          "prompt_digest",
          "model_policy",
          "source_commit",
          "created_at"
        ]
      }
    ]
  },
  "worker_contract": {
    "queue_kind": "database_or_redis_queue",
    "worker_lock_required": true,
    "lock_owner_field": "locked_by",
    "lock_expiry_field": "lock_expires_at",
    "heartbeat_required": true,
    "heartbeat_field": "heartbeat_at",
    "timeout_recovery_required": true,
    "idempotency_required": true,
    "dedupe_key_fields": [
      "source_file_sha256",
      "chain_id",
      "pipeline_version"
    ],
    "retry_policy": {
      "max_attempts_default": 3,
      "retry_only_when_status": "failed_retryable",
      "retry_resumes_from_checkpoint": true
    },
    "subprocess_execution": {
      "python_entrypoints_called_by_worker": true,
      "standard_cli_contract_required": true,
      "runtime_import_default_enabled": false,
      "database_write_by_python_chain_default_enabled": false,
      "model_call_requires_explicit_runtime_authorization": true
    }
  },
  "ui_contract": {
    "ui_knows_internal_nodes": false,
    "allowed_user_operations": [
      "upload_source_file",
      "create_task",
      "get_task_status",
      "list_task_artifacts",
      "get_question_package",
      "submit_review",
      "export_results"
    ],
    "ui_visible_task_fields": [
      "task_id",
      "chain_id",
      "status",
      "progress",
      "created_at",
      "updated_at",
      "last_error_code"
    ],
    "ui_hidden_fields": [
      "node_id",
      "prompt_digest",
      "model_policy",
      "internal_artifact_path"
    ]
  },
  "execution_safety_contract": {
    "model_invoked_by_contract_validation": false,
    "database_written_by_contract_validation": false,
    "runtime_imported_by_contract_validation": false,
    "business_secrets_read_by_contract_validation": false,
    "python_final_chains_are_subprocess_workers_only": true
  }
}
