# Local-only staging validation settings.
# This file is safe to commit because the dedicated local cluster uses trust auth
# and must only bind to localhost.

STAGING_VALIDATION_PGHOST=127.0.0.1
STAGING_VALIDATION_PGPORT=55432
STAGING_VALIDATION_PGUSER=postgres
STAGING_VALIDATION_DB=teachbase_validation_staging
STAGING_VALIDATION_RESTORE_DB=teachbase_validation_restore

# Optional overrides for the sampled validation inputs.
STAGING_VALIDATION_VISUAL_MANIFEST=outputs/visual_transcription_v0.1/case007_numberline_focus_20260702/runtime_out/06_6_asset_reconcile_refine/reconciled_refined_manifest.json
STAGING_VALIDATION_VISUAL_ASSET_BASE=outputs/visual_transcription_v0.1/case007_numberline_focus_20260702/runtime_out/06_asset_bundle
STAGING_VALIDATION_RUNTIME_MANIFEST=outputs/ingress_runtime_v0.1/english_narrative_teacher_runtime_v01/runtime_manifest.json
STAGING_VALIDATION_RUNTIME_BASE_DIR=outputs/ingress_runtime_v0.1/english_narrative_teacher_runtime_v01

# Keep the validation server usable for bursty fixture creation.
RUNTIME_RATE_LIMIT_WINDOW_MS=2000
RUNTIME_RATE_LIMIT_MAX_REQUESTS=500
