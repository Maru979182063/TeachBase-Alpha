{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Semantic Role Effectiveness Evaluation Case v0.1",
  "type": "object",
  "required": [
    "case_id",
    "subject",
    "document_type",
    "source_document_ref",
    "source_document_sha256",
    "page_range",
    "node_id",
    "source_artifact_ref",
    "source_image_ref",
    "source_text_stub",
    "current_node_type",
    "current_review_status",
    "current_review_reasons",
    "expected_semantic_role",
    "expected_presentation_kind",
    "expected_disposition",
    "expected_route_candidate",
    "expected_relations",
    "expected_needs_role_review",
    "gold_status",
    "gold_source",
    "gold_evidence",
    "difficulty_tags",
    "notes"
  ],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "subject": {"enum": ["math", "english", "biology", "unknown"]},
    "document_type": {"type": "string"},
    "source_document_ref": {"type": "string"},
    "source_document_sha256": {"type": "string"},
    "page_range": {"type": "array", "items": {"type": "integer"}},
    "node_id": {"type": "string"},
    "source_artifact_ref": {"type": "string"},
    "source_image_ref": {"type": "string"},
    "source_text_stub": {"type": "string", "maxLength": 240},
    "current_node_type": {"type": "string"},
    "current_review_status": {"type": "string"},
    "current_review_reasons": {"type": "array", "items": {"type": "string"}},
    "expected_semantic_role": {"type": "string"},
    "expected_presentation_kind": {"type": "string"},
    "expected_disposition": {"type": "string"},
    "expected_route_candidate": {"type": "string"},
    "expected_relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "target_node_id"],
        "properties": {
          "type": {"type": "string"},
          "target_node_id": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "expected_needs_role_review": {"type": "boolean"},
    "gold_status": {"enum": ["VERIFIED", "REVIEW_REQUIRED", "UNVERIFIED"]},
    "gold_source": {
      "enum": ["existing_manual_audit", "human_review", "fixture_contract", "candidate_discovery", "unverified"]
    },
    "gold_evidence": {"type": "array", "items": {"type": "string"}},
    "difficulty_tags": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
