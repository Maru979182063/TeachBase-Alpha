{
  "name": "jiaoyan-jijian-runtime-backbone",
  "private": true,
  "type": "module",
  "scripts": {
    "test:release-gate": "node tests/release_gate/run_release_gate.mjs --full --report-json --report-md",
    "test:three-track-baseline": "node tools/runtime_three_track_validation_baseline.mjs",
    "test:baseline-final-review": "node tools/runtime_baseline_final_review.mjs",
    "test:production-readiness": "node tools/runtime_backbone_production_readiness.mjs",
    "test:failure-injection": "node tools/runtime_backbone_failure_injection_checks.mjs",
    "test:backup-restore": "node tools/runtime_backbone_backup_restore.mjs",
    "test:load": "node tools/runtime_backbone_load_smoke.mjs",
    "test:soak": "node tools/runtime_backbone_soak.mjs",
    "test:postgres-live": "node tools/runtime_backbone_postgres_live_checks.mjs",
    "test:consistency": "node tools/runtime_backbone_consistency_check.mjs",
    "test:english-text-first-v05": "python -m pytest tests/test_english_text_first_v05_pipeline.py tests/test_english_text_first_sidecar_graph_v01.py -q",
    "test:docx-native-repair": "python -m pytest tests/test_docx_native_formula_providers.py tests/test_docx_native_formula_token_stream_v01.py tests/test_docx_native_text_repair_model_node_v01.py -q",
    "test:semantic-role-eval": "python -m pytest tests/test_semantic_role_eval_schema.py tests/test_semantic_role_eval_metrics.py tests/test_semantic_role_gold_leakage.py tests/test_semantic_role_effectiveness_run.py tests/test_semantic_role_golden_parity.py -q",
    "test:foundation-hardening": "python tools/run_foundation_hardening_gate.py",
    "test:precleanup-safety": "python tools/run_precleanup_safety_gate.py",
    "audit:worktree-compartments": "python tools/build_worktree_compartment_report.py",
    "audit:precleanup-deep": "python tools/build_precleanup_deep_audit.py",
    "audit:precleanup-post-archive": "python tools/build_precleanup_post_archive_report.py",
    "cleanup:archive-allowed": "python tools/execute_precleanup_archive.py",
    "cleanup:archive-allowed:dry-run": "python tools/execute_precleanup_archive.py --dry-run",
    "test:final-chain-registry": "python tools/validate_final_chain_registry.py --json && python -m pytest tests/test_final_chain_registry.py -q",
    "test:final-chain-surface": "python -m pytest tests/test_final_chain_surface_classifier.py -q",
    "test:final-chain-control": "python -m pytest tests/test_final_chain_control.py -q",
    "final-chain:list": "python tools/final_chain_control.py list",
    "final-chain:plan": "python tools/final_chain_control.py plan",
    "test:cleanup-candidates": "python -m pytest tests/test_cleanup_candidate_report.py -q",
    "test:repository-rescue-phase1": "python tools/run_repository_rescue_phase1_gate.py",
    "test:architecture-boundaries": "python -m pytest tests/test_architecture_boundaries.py -q",
    "test:modularization-phase2a": "python tools/run_modularization_phase2a_gate.py"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17"
  }
}
